# Copy to .env.local (git-ignored). Every value is optional.
#
# VITE_AI_PROVIDER   mock | http        (default: mock — deterministic, offline, no key needed)
# VITE_AI_ENDPOINT   Anthropic Messages API URL (default: https://api.anthropic.com/v1/messages)
# VITE_AI_API_KEY    API key for that endpoint (never commit a real key; VITE_ values are visible in the browser bundle)
# VITE_AI_MODEL      model id (default: claude-opus-5-5)
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=
